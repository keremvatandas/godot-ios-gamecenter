[configuration]
entry_symbol = "gamecenter_library_init"
compatibility_minimum = "4.5"

[libraries]
ios.release = "res://addons/gamecenter/bin/libgamecenter.ios.xcframework"
ios.debug = "res://addons/gamecenter/bin/libgamecenter.ios.xcframework"
macos.debug = "res://addons/gamecenter/bin/libgamecenter.macos.template_debug.universal.dylib"
macos.release = "res://addons/gamecenter/bin/libgamecenter.macos.template_release.universal.dylib"

[dependencies]
ios.release = {"GameKit.framework": ""}
ios.debug = {"GameKit.framework": ""}
